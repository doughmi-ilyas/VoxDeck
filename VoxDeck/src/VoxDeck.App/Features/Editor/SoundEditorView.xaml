<UserControl x:Class="VoxDeck.App.Features.Editor.SoundEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,14,12,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CloseCommand}"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close" />
                <TextBlock Text="Edit sound" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Command="{Binding Remove}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="Remove" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Ghost}" Command="{Binding ShowFile}" HorizontalAlignment="Left" ToolTip="{Binding FileText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="Show file" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="18,18,18,24">
                <!-- Preview -->
                <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource PlayBig}" Command="{Binding TogglePlay}" AutomationProperties.Name="Play or pause" Margin="0,0,12,0">
                            <TextBlock FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Setter Property="Margin" Value="2,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <StackPanel>
                            <controls:WaveformView Height="40" Peaks="{Binding Peaks}" Progress="{Binding Progress, Mode=OneWay}" StartMarker="{Binding StartMarker, Mode=OneWay}"
                                                   SeekCommand="{Binding Seek}" SetStartCommand="{Binding SetStart}" FocusVisualStyle="{StaticResource Focus}"
                                                   Fill="{DynamicResource Line2}" ProgressFill="{DynamicResource Accent}" MarkerFill="{DynamicResource Text}"
                                                   AutomationProperties.Name="Timeline" ToolTip="Click to jump · right-click to start here" />
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource FaintText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <TextBox Text="{Binding Name}" AutomationProperties.Name="Name" />

                <TextBlock Text="Volume" Style="{StaticResource Label}" Margin="0,18,0,4" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Volume, StringFormat={}{0:P0}}" Width="44" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Slider Value="{Binding Volume}" AutomationProperties.Name="Sound volume" />
                </DockPanel>

                <TextBlock Text="Hotkey" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="36" Height="36" Margin="8,0,0,0"
                            Command="{Binding ClearHotkey}" ToolTip="Remove hotkey" AutomationProperties.Name="Remove hotkey"
                            Visibility="{Binding HotkeyText, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource HotkeyButton}" Command="{Binding CaptureHotkey}" Tag="{Binding IsCapturing}" AutomationProperties.Name="Set hotkey">
                        <Grid>
                            <TextBlock Text="Press a key combination…" Visibility="{Binding IsCapturing, Converter={StaticResource Visible}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCapturing, Converter={StaticResource Visible}, ConverterParameter=not}">
                                <Border Style="{StaticResource Kbd}" Visibility="{Binding HotkeyText, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding HotkeyText}" FontSize="12" />
                                </Border>
                                <TextBlock Text="Click to set a hotkey" VerticalAlignment="Center"
                                           Visibility="{Binding HotkeyText, Converter={StaticResource Visible}, ConverterParameter=not}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DockPanel>
                <TextBlock Text="Works while you're in a game or another app. Esc cancels, Backspace clears." Style="{StaticResource FaintText}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="Start point" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Reset" Command="{Binding ResetStart}" Margin="4,0,0,0"
                            Visibility="{Binding HasStart, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="Use current position" Command="{Binding SetStart}" />
                    <TextBlock Text="{Binding StartText}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Tip: right-click the waveform to start the sound there." Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <Border Style="{StaticResource Card}" CornerRadius="10" Margin="0,20,0,0">
                    <StackPanel>
                        <DockPanel Margin="12,11">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Loop}" AutomationProperties.Name="Loop" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EE;" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Loop" FontWeight="Medium" />
                                <TextBlock Text="Repeats from the start point until stopped" Style="{StaticResource FaintText}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource Line}" />
                        <DockPanel Margin="12,11">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Favorite}" AutomationProperties.Name="Favorite" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Favorite" FontWeight="Medium" />
                                <TextBlock Text="Shows up under the Favorites filter" Style="{StaticResource FaintText}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding FormatText}" Style="{StaticResource FaintText}" Margin="0,16,0,0" />
                <TextBlock Text="{Binding FileText}" Style="{StaticResource FaintText}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
