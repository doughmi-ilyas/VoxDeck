<UserControl x:Class="VoxDeck.App.Features.Palette.PaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="OnVisibleChanged">
    <Grid>
        <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="OnBackdropClick" />
        <Border x:Name="Box" Width="600" VerticalAlignment="Top" Margin="0,92,0,0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="16" Direction="270" Opacity="0.3" />
            </Border.Effect>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="54" Margin="18,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="16" Foreground="{DynamicResource Faint}" Margin="0,0,12,0" />
                    <Grid>
                        <TextBox x:Name="Input" Style="{StaticResource BareInput}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnInputKey" AutomationProperties.Name="Search sounds and actions" />
                        <TextBlock Text="Search sounds and actions…" FontSize="16" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2,0,0,0"
                                   Visibility="{Binding Query, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </Grid>
                </DockPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" />
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,9">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Faint}" TextElement.FontSize="12">
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="↑↓" /></Border>
                        <TextBlock Text="Move" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" /></Border>
                        <TextBlock Text="Run" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Esc" /></Border>
                        <TextBlock Text="Close" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                             ItemContainerStyle="{StaticResource PaletteItem}" MaxHeight="380" Margin="8" Focusable="False"
                             PreviewMouseLeftButtonUp="OnItemClick" AutomationProperties.Name="Results">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}" Visibility="{Binding Shortcut, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding Shortcut}" />
                                    </Border>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="13" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource FaintText}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No matches" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,28"
                               Visibility="{Binding Results.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
