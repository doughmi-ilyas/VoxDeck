<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VoxDeck.App.Controls"
                    xmlns:modals="clr-namespace:VoxDeck.App.Features.Modals">

    <!-- The card every dialog sits in -->
    <Style x:Key="ModalCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24,22" />
        <Setter Property="Width" Value="440" />
        <Setter Property="controls:Motion.EnterOnLoad" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- New playlist / Rename playlist -->
    <DataTemplate DataType="{x:Type modals:PlaylistModal}">
        <Border Style="{StaticResource ModalCard}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="19" />
                <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" controls:AutoFocus.OnLoad="True"
                         AutomationProperties.Name="Playlist name">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding Confirm}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Pick sounds (only when creating) -->
                <StackPanel Visibility="{Binding HasSounds, Converter={StaticResource Visible}}">
                    <DockPanel Margin="0,18,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PickedText}" Style="{StaticResource FaintText}" VerticalAlignment="Bottom" />
                        <TextBlock Text="Sounds" Style="{StaticResource Label}" Margin="0" />
                    </DockPanel>
                    <Grid>
                        <TextBox Padding="32,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search sounds to add" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource Faint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search" Margin="33,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0" Padding="4">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sounds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Item.Model.Title}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Item.DurationText}" Style="{StaticResource FaintText}" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Item.Model.Title}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Command="{Binding Cancel}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Primary}" Content="{Binding ConfirmText}" Command="{Binding Confirm}" IsEnabled="{Binding CanConfirm}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Add to playlist -->
    <DataTemplate DataType="{x:Type modals:SaveToPlaylistModal}">
        <Border Style="{StaticResource ModalCard}" Width="380">
            <StackPanel>
                <TextBlock Text="Add to playlist" Style="{StaticResource H2}" FontSize="19" />
                <TextBlock Text="{Binding SoundTitle}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,14" />
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding NewPlaylist}" Height="40" Margin="0,0,0,8"
                        controls:AutoFocus.OnLoad="True">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="New playlist" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPlaylists, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIn}" AutomationProperties.Name="{Binding Chip.Label}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Chip.Count, StringFormat={}{0} sounds}" Style="{StaticResource FaintText}" Margin="10,0,0,0" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Chip.Label}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Tip: you can also drag a sound onto a playlist above your sounds." Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="2,12,0,0" />
                <Button Style="{StaticResource Primary}" Content="Done" Command="{Binding Done}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="22,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Are you sure? -->
    <DataTemplate DataType="{x:Type modals:ConfirmModal}">
        <Border Style="{StaticResource ModalCard}" Width="400">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Command="{Binding Cancel}" Margin="0,0,8,0" controls:AutoFocus.OnLoad="True" />
                    <Button Style="{StaticResource DangerButton}" Content="{Binding ConfirmText}" Command="{Binding Confirm}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
