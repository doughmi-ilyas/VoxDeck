<UserControl x:Class="VoxDeck.App.Features.Onboarding.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Radio dot: a ring that fills with a springy dot when chosen (Tag = chosen) -->
        <ControlTemplate x:Key="Radio" TargetType="ContentControl">
            <Grid Width="18" Height="18">
                <Ellipse x:Name="RingEl" Stroke="{DynamicResource Line2}" StrokeThickness="1.5" />
                <Ellipse x:Name="DotEl" Margin="4" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="0" ScaleY="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter TargetName="RingEl" Property="Stroke" Value="{DynamicResource Accent}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotEl" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="DotEl" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotEl" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="DotEl" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Option card in a list (devices): border lights up with a soft ring when chosen -->
        <Style x:Key="OptionItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="controls:Motion.PressScale" Value="0.985" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Glow" CornerRadius="17" Padding="3" Margin="-3" Background="Transparent">
                            <Border x:Name="Card" CornerRadius="14" BorderThickness="1" Padding="14,12"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Right" Template="{StaticResource Radio}" Tag="{TemplateBinding IsSelected}" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Line2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Glow" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same card as a button (voice chat yes/no). Tag = chosen. -->
        <Style x:Key="OptionCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="controls:Motion.PressScale" Value="0.985" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Glow" CornerRadius="17" Padding="3" Margin="-3,-3,-3,5" Background="Transparent">
                            <Border x:Name="Card" CornerRadius="14" BorderThickness="1" Padding="16"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Right" Template="{StaticResource Radio}" Tag="{TemplateBinding Tag}" Margin="12,2,0,0" VerticalAlignment="Top" Focusable="False" />
                                    <ContentPresenter />
                                </DockPanel>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Line2}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Glow" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" TextDecorations="Underline" Background="Transparent" Padding="4,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource FaintText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <!-- Dotted background, faded out towards the edges -->
        <DrawingBrush x:Key="Dots" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Viewbox="0,0,26,26" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource Line2}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <RadialGradientBrush x:Key="CenterFade" RadiusX="0.5" RadiusY="0.45">
            <GradientStop Color="Black" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Bg}" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>

        <!-- Ambient aurora: three soft colour blobs drifting slowly; the whole field shifts left as you progress -->
        <Grid x:Name="Aurora" IsHitTestVisible="False" Margin="-300">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="AuroraShift" />
            </Grid.RenderTransform>
            <Ellipse Width="980" Height="980" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,40,0,0" Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5B82F5" Offset="0" />
                        <GradientStop Color="#005B82F5" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="980" Height="980" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="980" Height="980" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-60" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06B6D4" Offset="0" />
                        <GradientStop Color="#0006B6D4" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <Rectangle Fill="{StaticResource Dots}" OpacityMask="{StaticResource CenterFade}" Opacity="0.45" IsHitTestVisible="False" />

        <!-- ================= Splash ================= -->
        <Grid x:Name="SplashScreen" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
            <!-- Expanding rings behind the logo -->
            <Canvas x:Name="Waves" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90" Width="0" Height="0" IsHitTestVisible="False" />
            <!-- Spectrum along the bottom -->
            <UniformGrid x:Name="Spectrum" Rows="1" VerticalAlignment="Bottom" Height="240" Margin="40,0" IsHitTestVisible="False" Opacity="0">
                <UniformGrid.OpacityMask>
                    <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.5" RadiusY="1">
                        <GradientStop Color="Black" Offset="0.3" />
                        <GradientStop Color="Transparent" Offset="0.85" />
                    </RadialGradientBrush>
                </UniformGrid.OpacityMask>
            </UniformGrid>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,0,30,40">
                <Grid HorizontalAlignment="Center">
                    <Ellipse Width="220" Height="220" HorizontalAlignment="Left" Margin="-70,-60,0,-60" Opacity="0.3" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5B82F5" Offset="0" />
                                <GradientStop Color="#005B82F5" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Orientation="Horizontal">
                        <controls:LogoMark x:Name="SplashMark" Width="86" Height="86" />
                        <StackPanel x:Name="Wordmark" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SplashSub" Text="Your sounds, in every voice chat." FontSize="18" FontWeight="Medium" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" Margin="0,26,0,0" />
                <StackPanel x:Name="SplashCta" Margin="0,34,0,0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource Big}" Command="{Binding Start}" HorizontalAlignment="Center" AutomationProperties.Name="Get started">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Get started" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Takes about a minute. You can change everything later." Style="{StaticResource FaintText}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <Button Style="{StaticResource LinkButton}" Content="Skip setup" Command="{Binding Skip}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= Steps ================= -->
        <Grid x:Name="FlowScreen" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Progress -->
            <DockPanel Margin="36,22,36,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource FaintText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:LogoMark Width="16" Height="16" />
                    <TextBlock Text="VoxDeck setup" FontWeight="SemiBold" Margin="8,0,20,0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Segments}" MaxWidth="360" HorizontalAlignment="Left" Width="360" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="3" Margin="3,0">
                                <Border CornerRadius="2" Background="{DynamicResource Line}" />
                                <Border x:Name="Fill" CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Filled}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.8">
                                                    <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Left: the question. Right: a live picture of it. -->
            <Grid Grid.Row="1" Margin="36,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition x:Name="VisualColumn" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Focusable="False">
                    <StackPanel x:Name="Left" MaxWidth="470" HorizontalAlignment="Right" Margin="0,10,40,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="16" Height="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Current.Eyebrow}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                        <WrapPanel x:Name="TitleWords" />
                        <TextBlock Text="{Binding Current.Subtitle}" FontSize="15" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,24" LineHeight="23" />

                        <Grid>
                            <!-- 1. Microphone -->
                            <StackPanel x:Name="Body1">
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Audio.Microphones}" SelectedItem="{Binding Audio.SelectedMic}"
                                         ItemContainerStyle="{StaticResource OptionItem}" MaxHeight="270" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Microphones">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE720;" FontSize="18" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
                                                <controls:SegMeter DockPanel.Dock="Right" Width="56" Height="5" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Level="{Binding DataContext.Audio.Level, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   On="{DynamicResource Accent}" Off="{DynamicResource Line}" Hot="{DynamicResource Warn}"
                                                                   Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource Visible}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource FaintText}" TextWrapping="Wrap"
                                                               Visibility="{Binding Detail, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource Note}" Text="{Binding Audio.MicStatus}" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" Text="Your Windows microphone settings and enhancements stay exactly as they are." />
                            </StackPanel>

                            <!-- 2. Headphones -->
                            <StackPanel x:Name="Body2" Visibility="Collapsed">
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Audio.Outputs}" SelectedItem="{Binding Audio.SelectedOutput}"
                                         ItemContainerStyle="{StaticResource OptionItem}" MaxHeight="270" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Outputs">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="18" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Detail, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Command="{Binding Audio.TestOutput}" Click="OnTestSound" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Play test sound">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Play test sound" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 3. Sounds -->
                            <StackPanel x:Name="Body3" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Primary}" Command="{Binding Library.ImportFiles}" Height="40" Padding="18,0" AutomationProperties.Name="Add sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Add sounds" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Library.Subtitle}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" Text="Tip: you can also drag audio files onto the window at any time. Skip this if you'd rather add them later." />
                            </StackPanel>

                            <!-- 4. Stop-all shortcut -->
                            <StackPanel x:Name="Body4" Visibility="Collapsed" DataContext="{Binding StopAll}">
                                <Button Style="{StaticResource HotkeyButton}" Command="{Binding Capture}" Tag="{Binding IsCapturing}" Height="46" AutomationProperties.Name="Set the stop-all shortcut">
                                    <Grid>
                                        <TextBlock Text="Press a key combination…" Visibility="{Binding IsCapturing, Converter={StaticResource Visible}}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCapturing, Converter={StaticResource Visible}, ConverterParameter=not}">
                                            <Border Style="{StaticResource Kbd}" Visibility="{Binding Text, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding Text}" FontSize="13" />
                                            </Border>
                                            <TextBlock Text="Click to choose a shortcut" VerticalAlignment="Center"
                                                       Visibility="{Binding Text, Converter={StaticResource Visible}, ConverterParameter=not}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DockPanel Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Remove" Command="{Binding Clear}"
                                            Visibility="{Binding Text, Converter={StaticResource Visible}}" />
                                    <TextBlock Style="{StaticResource FaintText}" Text="Try Ctrl+Shift+S or F12. Esc cancels." VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>

                            <!-- 5. Voice chat -->
                            <StackPanel x:Name="Body5" Visibility="Collapsed">
                                <Button Style="{StaticResource OptionCard}" Command="{Binding ChooseVoiceChat}" CommandParameter="yes" Tag="{Binding WantsVoiceChat}"
                                        AutomationProperties.Name="Yes, play them in voice chat">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE716;" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="Yes, play them in voice chat" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="Your voice and your sounds reach Discord and games through a free virtual cable." Style="{StaticResource FaintText}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource OptionCard}" Command="{Binding ChooseVoiceChat}" CommandParameter="no" Tag="{Binding WantsNoVoiceChat}"
                                        AutomationProperties.Name="No, only me">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="20" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="No, only me" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="Sounds play in your headphones. Switch any time with the Me / Both / Chat button." Style="{StaticResource FaintText}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <!-- Needs a cable -->
                                <Border CornerRadius="12" Padding="14,12" Margin="0,6,0,0" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        Visibility="{Binding NeedsCable, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <TextBlock Text="One more thing: install VB-CABLE (free, about two minutes)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="It adds a microphone Discord can pick, which VoxDeck fills with your voice and your sounds. Restart Windows after installing." Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Get VB-CABLE" Command="{Binding Mixer.GetCable}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource Ghost}" Content="Check again" Command="{Binding Mixer.CheckAgain}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Cable found -->
                                <Border CornerRadius="12" Padding="14,12" Margin="0,6,0,0" Background="{DynamicResource OkSoft}"
                                        Visibility="{Binding CableReady, Converter={StaticResource Visible}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Copy name" Command="{Binding Mixer.CopyMicName}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ok}" VerticalAlignment="Center">
                                            <Run Text="Ready. In Discord, choose" /> <Run Text="{Binding Mixer.CableMicName, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="as your input device." />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: glass panel with one live visual per step -->
                <Border x:Name="Panel" Grid.Column="1" CornerRadius="24" MaxHeight="540" Margin="20,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource Line}" ClipToBounds="True">
                    <Grid>
                        <Border Background="{DynamicResource Surface}" Opacity="0.72" CornerRadius="23" />
                        <Rectangle Fill="{StaticResource Dots}" Opacity="0.6" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <!-- 1. Mic orb: rings breathe with your voice -->
                        <StackPanel x:Name="Vis1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="240" Height="240">
                                <Ellipse x:Name="Ring1" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5" /></Ellipse.RenderTransform></Ellipse>
                                <Ellipse x:Name="Ring2" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.62" ScaleY="0.62" /></Ellipse.RenderTransform></Ellipse>
                                <Ellipse x:Name="Ring3" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.74" ScaleY="0.74" /></Ellipse.RenderTransform></Ellipse>
                                <!-- Spinning arc around the orb -->
                                <Ellipse Width="136" Height="136" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" x:Name="OrbArc">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#008B5CF6" Offset="0" />
                                            <GradientStop Color="#005B82F5" Offset="0.5" />
                                            <GradientStop Color="#5B82F5" Offset="0.85" />
                                            <GradientStop Color="#8B5CF6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Grid x:Name="Orb" Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                                    <Ellipse Fill="{DynamicResource Accent}" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.32,0.26" Center="0.32,0.26" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                                <GradientStop Color="#33000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="38" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding Audio.SelectedMic.Name}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="20,22,20,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Say something" Style="{StaticResource FaintText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <controls:SegMeter Width="220" Height="7" Margin="0,14,0,0" Level="{Binding Audio.Level}"
                                               On="{DynamicResource Accent}" Off="{DynamicResource Line}" Hot="{DynamicResource Warn}" />
                        </StackPanel>

                        <!-- 2. Speaker: pings when the test sound plays -->
                        <StackPanel x:Name="Vis2" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                            <Grid Width="300" Height="220">
                                <Path x:Name="ArcLeft" Data="M 40,10 Q 0,60 40,110 M 52,30 Q 26,60 52,90 M 64,48 Q 54,60 64,72" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Path x:Name="ArcRight" Data="M 40,10 Q 0,60 40,110 M 52,30 Q 26,60 52,90 M 64,48 Q 54,60 64,72" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                                </Path>
                                <Border x:Name="Ping1" Width="116" Height="116" CornerRadius="30" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                </Border>
                                <Border x:Name="Ping2" Width="116" Height="116" CornerRadius="30" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                </Border>
                                <Border x:Name="SpeakerCore" Width="116" Height="116" CornerRadius="30" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.15" /></Border.Effect>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="50" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Audio.SelectedOutput.Name}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="20,18,20,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Press “Play test sound”" Style="{StaticResource FaintText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 3. Library preview -->
                        <Grid x:Name="Vis3" Opacity="0" Width="380" VerticalAlignment="Center" Margin="24">
                            <StackPanel>
                                <DockPanel Margin="2,0,2,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Library.Items.Count, StringFormat={}{0} sounds}" Style="{StaticResource FaintText}" />
                                    <TextBlock Text="Your sounds" FontWeight="SemiBold" />
                                </DockPanel>
                                <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="14" Padding="20,26"
                                        Visibility="{Binding Library.IsEmpty, Converter={StaticResource Visible}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="26" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Your sounds show up here" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Library.Items}" MaxHeight="300" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8"
                                                    controls:Motion.EnterStagger="True">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0">
                                                        <controls:LogoMark Width="14" Height="14" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Model.Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- 4. Keycaps -->
                        <StackPanel x:Name="Vis4" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" DataContext="{Binding StopAll}">
                            <Border x:Name="Keycap" MinWidth="200" Height="96" CornerRadius="16" BorderThickness="1,1,1,4" Padding="28,0" HorizontalAlignment="Center"
                                    Background="{DynamicResource Surface}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.14" /></Border.Effect>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Visibility="{Binding Text, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="? + ?" FontFamily="{StaticResource MonoFont}" FontSize="30" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"
                                               Visibility="{Binding Text, Converter={StaticResource Visible}, ConverterParameter=not}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Stops every sound, from anywhere" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,26,0,0" />
                            <TextBlock Text="Even while a game has the focus" Style="{StaticResource FaintText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 5. Flow: mic + sounds → VoxDeck → Discord -->
                        <Viewbox x:Name="Vis5" Opacity="0" Stretch="Uniform" Margin="30" MaxWidth="520">
                            <Canvas Width="460" Height="260">
                                <Path Data="M 120,70 C 170,70 170,130 200,130 M 120,190 C 170,190 170,130 200,130" Stroke="{DynamicResource Line2}" StrokeThickness="1.5" />
                                <Path x:Name="FlowIn" Data="M 120,70 C 170,70 170,130 200,130 M 120,190 C 170,190 170,130 200,130" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeDashArray="2 6" />
                                <Grid x:Name="VoicePart">
                                    <Path Data="M 300,130 L 340,130" Stroke="{DynamicResource Line2}" StrokeThickness="1.5" />
                                    <Path x:Name="FlowOut" Data="M 300,130 L 340,130" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeDashArray="2 6" />
                                    <Border Canvas.Left="0" Margin="340,104,0,0" Width="112" Height="52" CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Discord" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="or any game" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Canvas.Left="8" Canvas.Top="44" Width="112" Height="52" CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Your mic" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="your voice" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Canvas.Left="8" Canvas.Top="164" Width="112" Height="52" CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Your sounds" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="from VoxDeck" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Canvas.Left="200" Canvas.Top="102" Width="100" Height="56" CornerRadius="12" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="VoxDeck" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                        <TextBlock Text="mix" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="36,16,36,22">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Command="{Binding Back}" AutomationProperties.Name="Back">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Back" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding Next}" MinWidth="120" Height="38" AutomationProperties.Name="Continue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NextText}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Skip setup" Command="{Binding Skip}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= All set ================= -->
        <Grid x:Name="DoneScreen" Visibility="Collapsed" Opacity="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <Grid x:Name="DoneBadge" Width="88" Height="88" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                    <Ellipse Fill="{DynamicResource Accent}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="38" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" />
                </Grid>
                <TextBlock Text="You're all set" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24,0,0" />
                <TextBlock Text="Click a sound to play it. Press Ctrl+K to find anything." FontSize="15" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,6" Margin="0,26,0,0" MinWidth="380">
                    <StackPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Audio.SelectedMic.Name}" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="Microphone" Foreground="{DynamicResource Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Audio.SelectedOutput.Name}" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="Headphones" Foreground="{DynamicResource Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Library.Items.Count}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="Sounds" Foreground="{DynamicResource Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StopAllText}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="Stop all" Foreground="{DynamicResource Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VoiceChatText}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="Voice chat" Foreground="{DynamicResource Muted}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Big}" Command="{Binding Finish}" HorizontalAlignment="Center" Margin="0,28,0,0" AutomationProperties.Name="Open VoxDeck">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open VoxDeck" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sparks and confetti -->
        <Canvas x:Name="Particles" IsHitTestVisible="False" />
    </Grid>
</UserControl>
