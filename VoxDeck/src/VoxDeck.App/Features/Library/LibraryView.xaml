<UserControl x:Class="VoxDeck.App.Features.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls"
             controls:Motion.EnterOnLoad="True">
    <Grid Margin="26,22,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- New playlist: click for the dialog, or drop a sound on it -->
                <Button x:Name="NewPlaylistButton" Command="{Binding NewPlaylist}" Margin="0,0,8,0" AllowDrop="True"
                        DragOver="OnNewPlaylistDragOver" DragLeave="OnNewPlaylistDragLeave" Drop="OnNewPlaylistDrop"
                        AutomationProperties.Name="New playlist" ToolTip="Make a playlist. You can also drop a sound here.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <Trigger Property="Tag" Value="drop">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="New playlist" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Primary}" Command="{Binding ImportFiles}" AutomationProperties.Name="Add sounds"
                        Visibility="{Binding IsPlaylistView, Converter={StaticResource Visible}, ConverterParameter=not}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Add sounds" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Playlist actions -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlaylistView, Converter={StaticResource Visible}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="36" Height="36" Command="{Binding DeletePlaylist}"
                            ToolTip="Delete playlist" AutomationProperties.Name="Delete playlist" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" Width="36" Height="36" Margin="2,0,8,0" Command="{Binding RenamePlaylist}"
                            ToolTip="Rename playlist" AutomationProperties.Name="Rename playlist" />
                    <Button Command="{Binding ImportFiles}" Margin="0,0,8,0" AutomationProperties.Name="Add sounds to this playlist"
                            ToolTip="Add audio files to your library and to this playlist (Ctrl+O, or drop files on the window)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Add sounds" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShufflePlaylist}" Margin="0,0,8,0" AutomationProperties.Name="Shuffle playlist">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Shuffle" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Primary}" Command="{Binding PlayPlaylist}" AutomationProperties.Name="Play all">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Play all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Search + filters + playlists (playlists accept dropped sounds) -->
        <DockPanel Grid.Row="1" Margin="0,20,12,8">
            <Grid Width="260" DockPanel.Dock="Left" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Padding="34,0,32,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search sounds" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource Faint}"
                           Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Search your sounds" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Faint}"
                           Visibility="{Binding Search, Converter={StaticResource Visible}, ConverterParameter=not}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,6,0"
                        Command="{Binding ClearSearch}" ToolTip="Clear search" AutomationProperties.Name="Clear search"
                        Visibility="{Binding Search, Converter={StaticResource Visible}}" />
            </Grid>
            <ListBox x:Name="Chips" Style="{StaticResource ChipList}" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Margin="12,0,0,0"
                     VerticalAlignment="Center" AutomationProperties.Name="Filter">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItem}">
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <EventSetter Event="DragOver" Handler="OnChipDragOver" />
                        <EventSetter Event="DragLeave" Handler="OnChipDragLeave" />
                        <EventSetter Event="Drop" Handler="OnChipDrop" />
                        <Style.Triggers>
                            <!-- While a sound is dragged, playlists say "drop here" -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPlaylist}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsDragging, ElementName=Chips}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="12" Margin="0,0,7,0"
                                       Visibility="{Binding IsPlaylist, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Label}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.6" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Tiles (drag one to a playlist; inside a playlist, drop on another tile to reorder) -->
        <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="OnScrollerSizeChanged" Focusable="False">
            <!-- UniformGrid doesn't virtualize; switch to a virtualizing panel past a few thousand sounds. -->
            <ItemsControl x:Name="Tiles" ItemsSource="{Binding Items}" Margin="-6,4,6,24" Focusable="False" AllowDrop="True"
                          PreviewMouseLeftButtonDown="OnTilesMouseDown" PreviewMouseMove="OnTilesMouseMove"
                          DragOver="OnTilesDragOver" DragLeave="OnTilesDragLeave" Drop="OnTilesDrop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid VerticalAlignment="Top" Loaded="OnGridLoaded" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Tile" Style="{StaticResource Tile}" Command="{Binding DataContext.Play, ElementName=Tiles}" CommandParameter="{Binding}"
                                Tag="{Binding DataContext, ElementName=Tiles}" AutomationProperties.Name="{Binding Model.Title}"
                                controls:Motion.HoverLift="True" controls:Motion.PressScale="0.98" controls:Motion.Ripple="True" controls:Motion.EnterStagger="True">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play" Command="{Binding PlacementTarget.Tag.Play, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Edit…" Command="{Binding PlacementTarget.Tag.EditSound, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="{Binding FavoriteMenuText}" Command="{Binding PlacementTarget.Tag.ToggleFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Add to playlist…" Command="{Binding PlacementTarget.Tag.AddToPlaylist, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Move earlier" Command="{Binding PlacementTarget.Tag.MoveEarlier, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                              Visibility="{Binding PlacementTarget.Tag.IsPlaylistView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Visible}}" />
                                    <MenuItem Header="Move later" Command="{Binding PlacementTarget.Tag.MoveLater, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                              Visibility="{Binding PlacementTarget.Tag.IsPlaylistView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Visible}}" />
                                    <MenuItem Header="Remove from this playlist" Command="{Binding PlacementTarget.Tag.RemoveFromPlaylist, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                              Visibility="{Binding PlacementTarget.Tag.IsPlaylistView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Visible}}" />
                                    <Separator />
                                    <MenuItem Header="Remove from library" Command="{Binding PlacementTarget.Tag.Remove, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TileAction}" Content="&#xE70F;" ToolTip="Edit"
                                            AutomationProperties.Name="Edit" Command="{Binding DataContext.EditSound, ElementName=Tiles}" CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FavAction}" ToolTip="Favorite" AutomationProperties.Name="Favorite"
                                            Command="{Binding DataContext.ToggleFavorite, ElementName=Tiles}" CommandParameter="{Binding}" controls:Motion.PressScale="0.75" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TileAction}" Content="&#xE710;" ToolTip="Add to playlist"
                                            AutomationProperties.Name="Add to playlist" Command="{Binding DataContext.AddToPlaylist, ElementName=Tiles}" CommandParameter="{Binding}" />
                                    <TextBlock x:Name="TagText" Text="{Binding Tag}" Style="{StaticResource FaintText}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <controls:EqBars DockPanel.Dock="Left" IsActive="{Binding IsPlaying}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Model.Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model.Title}" />
                                </DockPanel>
                                <controls:WaveformView Height="30" Margin="0,10,2,0" Focusable="False" Peaks="{Binding TilePeaks}" Progress="{Binding Progress}"
                                                       SeekCommand="{Binding PlayAt}" Fill="{DynamicResource Line2}" ProgressFill="{DynamicResource Accent}"
                                                       ToolTip="Click to play from here" />
                                <DockPanel Margin="0,10,2,0">
                                    <Border DockPanel.Dock="Right" x:Name="KeyCap" Style="{StaticResource Kbd}" Visibility="{Binding HotkeyText, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding HotkeyText}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="No hotkey" Style="{StaticResource FaintText}" FontSize="11" Opacity="0.8"
                                               Visibility="{Binding HotkeyText, Converter={StaticResource Visible}, ConverterParameter=not}" />
                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource FaintText}" />
                                </DockPanel>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource TileActive}" />
                                <Setter TargetName="KeyCap" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter TargetName="KeyCap" Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HotkeyFailed}" Value="True">
                                <Setter TargetName="KeyCap" Property="BorderBrush" Value="{DynamicResource Danger}" />
                                <Setter TargetName="KeyCap" Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                                <Setter TargetName="KeyCap" Property="ToolTip" Value="Another app is using this shortcut" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- While dragging: what you can do with the sound -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,12,18" Padding="16,9" CornerRadius="20"
                Background="{DynamicResource Accent}" IsHitTestVisible="False"
                Visibility="{Binding IsDragging, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Foreground="{DynamicResource OnAccent}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding DragHint}" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Empty library -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,60"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                <controls:LogoMark Width="34" Height="34" />
            </Border>
            <TextBlock Text="Your soundboard is empty" Style="{StaticResource H2}" FontSize="17" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Text="Add audio files or drag them anywhere onto this window. Your files stay where they are."
                       Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Margin="0,6,0,0" />
            <Button Style="{StaticResource Primary}" Command="{Binding ImportFiles}" HorizontalAlignment="Center" Margin="0,20,0,0" Height="40" Padding="20,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Add sounds" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Empty playlist -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,12,0"
                    Visibility="{Binding IsPlaylistEmpty, Converter={StaticResource Visible}}">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="This playlist is empty" Style="{StaticResource H2}" FontSize="17" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="Press Add sounds (or drop files here) to add new ones, or open All and drag sounds onto this playlist. They play one after another, in order."
                       Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,6,0,0" />
            <Button Command="{Binding ShowAll}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="Show all sounds" />
        </StackPanel>

        <!-- No matches -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,12,0"
                    Visibility="{Binding NoResults, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="26" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing matches" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="Try another word or a different filter." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
