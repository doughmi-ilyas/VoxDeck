<UserControl x:Class="VoxDeck.App.Features.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" Background="Transparent">
    <Grid Margin="28,24,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,14,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260">
                    <TextBox x:Name="SearchBox" Padding="34,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search sounds" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource TextMuted}"
                               Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search sounds" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="OnImport" AutomationProperties.Name="Import sounds">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Import" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Library" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,14,14,0" />

        <ScrollViewer Grid.Row="2" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- WrapPanel doesn't virtualize; switch to a virtualizing panel past a few thousand sounds. -->
            <ItemsControl x:Name="Tiles" ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Tile" Style="{StaticResource Tile}" ToolTip="{Binding Model.Path}" AutomationProperties.Name="{Binding Model.Title}"
                                Command="{Binding DataContext.Play, ElementName=Tiles}" CommandParameter="{Binding}"
                                Tag="{Binding DataContext, ElementName=Tiles}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove from library" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.Remove, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="PlayIcon" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Left" Background="{StaticResource SurfacePressed}">
                                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" HorizontalAlignment="Center" Margin="2,0,0,0" />
                                </Border>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EE;" FontSize="13" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Loops"
                                           Visibility="{Binding Model.Loop, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="2" Text="{Binding Model.Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                <TextBlock Grid.Row="3" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" />
                                <ProgressBar x:Name="TileProgress" Grid.Row="3" Style="{StaticResource Meter}" Height="3" Value="{Binding Progress, Mode=OneWay}"
                                             VerticalAlignment="Bottom" Margin="0,0,0,-7" Visibility="Hidden" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="PlayIcon" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="PlayGlyph" Property="Foreground" Value="{StaticResource OnAccent}" />
                                <Setter TargetName="PlayGlyph" Property="Text" Value="&#xE767;" />
                                <Setter TargetName="PlayGlyph" Property="Margin" Value="0" />
                                <Setter TargetName="TileProgress" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,40">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Surface}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="No sounds yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="Import audio files or drag them here. Your files stay where they are." Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <Button Style="{StaticResource AccentButton}" Content="Import sounds" Click="OnImport" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
