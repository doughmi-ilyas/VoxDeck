<UserControl x:Class="VoxDeck.App.Features.Mixer.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls"
             controls:Motion.EnterOnLoad="True" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Strip" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StripIcon" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style x:Key="StripValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <Style x:Key="FlowNode" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FlowArrow" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE72A;" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,32" MaxWidth="940" HorizontalAlignment="Left">
            <!-- Header with the master switch -->
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Padding="14,10" VerticalAlignment="Center" IsEnabled="{Binding HasCable}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Send to voice chat" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" AutomationProperties.Name="Send to voice chat" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Mixer" Style="{StaticResource H1}" />
                    <TextBlock Text="Mix your microphone and your sounds into one microphone for Discord, games and other voice apps."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Status -->
            <Border x:Name="Status" CornerRadius="12" Padding="14,11" Margin="0,18,0,0" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface2}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                <Setter Property="Background" Value="{DynamicResource OkSoft}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <controls:EqBars DockPanel.Dock="Left" IsActive="{Binding Router.IsRunning}" Margin="0,0,12,0" VerticalAlignment="Center"
                                     Visibility="{Binding Router.IsRunning, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="15" Margin="0,0,10,0"
                               Visibility="{Binding Router.IsRunning, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Setup: no virtual cable yet -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,18,0,0" Visibility="{Binding HasCable, Converter={StaticResource Visible}, ConverterParameter=not}">
                <StackPanel>
                    <TextBlock Text="Install a free virtual audio cable" Style="{StaticResource H2}" FontSize="17" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18"
                               Text="Discord can only pick microphones that Windows knows about. A virtual cable adds one that VoxDeck can fill with your voice and your sounds. You install it once; VoxDeck never installs drivers by itself." />
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource Step}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding GetCable}" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open download page" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Download VB-CABLE" FontWeight="SemiBold" />
                            <TextBlock Text="It's free from vb-audio.com. Pick the Windows download (the .zip)." Style="{StaticResource FaintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource Step}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel>
                            <TextBlock Text="Install it as administrator" FontWeight="SemiBold" />
                            <TextBlock Text="Unzip it, right-click VBCABLE_Setup_x64.exe, choose “Run as administrator”, then “Install Driver”." Style="{StaticResource FaintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource Step}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <Button DockPanel.Dock="Right" Command="{Binding CheckAgain}" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Check again" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Restart Windows, then come back" FontWeight="SemiBold" />
                            <TextBlock Text="VoxDeck finds the cable by itself. Your normal speakers and microphone don't change." Style="{StaticResource FaintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Mixer strips -->
            <Grid Margin="0,18,-12,0" Visibility="{Binding HasCable, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Microphone → call -->
                <Border Style="{StaticResource Strip}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StripIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE720;" HorizontalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Microphone" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Router.MicName}" Style="{StaticResource FaintText}" FontSize="11" ToolTip="{Binding Router.MicName}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <controls:SegMeter Vertical="True" Width="8" Height="190" Level="{Binding MicLevel}" Margin="0,0,14,0"
                                               On="{DynamicResource Accent}" Off="{DynamicResource Line}" Hot="{DynamicResource Warn}" />
                            <Slider Style="{StaticResource Fader}" Maximum="2" Value="{Binding MicGain}" AutomationProperties.Name="Microphone volume" />
                        </StackPanel>
                        <TextBlock Text="{Binding MicGain, StringFormat={}{0:P0}}" Style="{StaticResource StripValue}" />
                        <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding MicMuted}" Margin="0,10,0,0" AutomationProperties.Name="Mute microphone">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEC54;" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Mute" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Sounds → call -->
                <Border Grid.Column="1" Style="{StaticResource Strip}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StripIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" HorizontalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Sounds in call" FontWeight="SemiBold" />
                                <TextBlock Text="What others hear" Style="{StaticResource FaintText}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                        <Slider Style="{StaticResource Fader}" Value="{Binding CallSoundVolume}" Margin="0,16,0,0" HorizontalAlignment="Center"
                                AutomationProperties.Name="Sound volume in voice chat" />
                        <TextBlock Text="{Binding CallSoundVolume, StringFormat={}{0:P0}}" Style="{StaticResource StripValue}" />
                        <TextBlock Text="Separate from what you hear" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <!-- Sounds → you -->
                <Border Grid.Column="2" Style="{StaticResource Strip}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StripIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" HorizontalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Sounds you hear" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Router.MonitorName}" Style="{StaticResource FaintText}" FontSize="11" ToolTip="{Binding Router.MonitorName}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <controls:SegMeter Vertical="True" Width="8" Height="190" Level="{Binding MonitorLevel}" Margin="0,0,14,0"
                                               On="{DynamicResource Accent}" Off="{DynamicResource Line}" Hot="{DynamicResource Warn}" />
                            <Slider Style="{StaticResource Fader}" Value="{Binding MasterVolume}" AutomationProperties.Name="Volume of sounds you hear" />
                        </StackPanel>
                        <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:P0}}" Style="{StaticResource StripValue}" />
                        <TextBlock Text="Your voice never plays back here" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <!-- Call output -->
                <Border Grid.Column="3" Style="{StaticResource Strip}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StripIcon}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" HorizontalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Voice chat" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CableSpeakerName}" Style="{StaticResource FaintText}" FontSize="11" ToolTip="{Binding CableSpeakerName}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:SegMeter Vertical="True" Width="22" Height="190" Level="{Binding CallLevel}" Margin="0,16,0,0" HorizontalAlignment="Center"
                                           On="{DynamicResource Ok}" Off="{DynamicResource Line}" Hot="{DynamicResource Warn}" />
                        <TextBlock Text="Live" Style="{StaticResource StripValue}" Visibility="{Binding Router.IsRunning, Converter={StaticResource Visible}}" Foreground="{DynamicResource Ok}" />
                        <TextBlock Text="Off" Style="{StaticResource StripValue}" Visibility="{Binding Router.IsRunning, Converter={StaticResource Visible}, ConverterParameter=not}" Foreground="{DynamicResource Faint}" />
                        <TextBlock Text="A limiter stops it from clipping" Style="{StaticResource FaintText}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- How it's wired -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0" Visibility="{Binding HasCable, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="How it's wired" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource FlowNode}"><TextBlock Text="Your mic" FontWeight="SemiBold" /></Border>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Foreground="{DynamicResource Faint}" Margin="8,0" />
                        <Border Style="{StaticResource FlowNode}"><TextBlock Text="Your sounds" FontWeight="SemiBold" /></Border>
                        <TextBlock Style="{StaticResource FlowArrow}" />
                        <Border Style="{StaticResource FlowNode}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}">
                            <TextBlock Text="VoxDeck mix" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                        </Border>
                        <TextBlock Style="{StaticResource FlowArrow}" />
                        <Border Style="{StaticResource FlowNode}">
                            <StackPanel>
                                <TextBlock Text="{Binding CableSpeakerName}" FontWeight="SemiBold" />
                                <TextBlock Text="virtual cable" Style="{StaticResource FaintText}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource FlowArrow}" />
                        <Border Style="{StaticResource FlowNode}">
                            <StackPanel>
                                <TextBlock Text="Discord / game" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CableMicName, StringFormat=mic: {0}}" Style="{StaticResource FaintText}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel Visibility="{Binding HasSeveralCables, Converter={StaticResource Visible}}" Margin="0,16,0,0">
                        <TextBlock Text="Virtual cable to use" Style="{StaticResource Label}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Cables}" SelectedItem="{Binding SelectedCable}"
                                 ItemContainerStyle="{StaticResource Option}" Margin="3,0" AutomationProperties.Name="Virtual cables">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Speaker.Name}" FontWeight="SemiBold" AutomationProperties.Name="{Binding Speaker.Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Discord setup -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0" Visibility="{Binding HasCable, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Set up Discord (once)" Style="{StaticResource H2}" />
                    <TextBlock Text="User Settings → Voice &amp; Video" Style="{StaticResource FaintText}" Margin="0,2,0,14" />
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource Step}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <Button DockPanel.Dock="Right" Command="{Binding CopyMicName}" Margin="12,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Copy name" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Input Device" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Kbd}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,3">
                                <TextBlock Text="{Binding CableMicName}" FontSize="12" Foreground="{DynamicResource Text}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource Step}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel>
                            <TextBlock Text="Noise Suppression: Standard or None" FontWeight="SemiBold" />
                            <TextBlock Text="Krisp treats music and sound effects as noise and removes them." Style="{StaticResource FaintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource Step}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel>
                            <TextBlock Text="If sounds cut in and out" FontWeight="SemiBold" />
                            <TextBlock Text="Turn off Echo Cancellation and Automatic Gain Control, and lower Input Sensitivity a little." Style="{StaticResource FaintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource Step}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel>
                            <TextBlock Text="Games, OBS and other apps" FontWeight="SemiBold" />
                            <TextBlock Text="Pick the same microphone in their voice settings." Style="{StaticResource FaintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- End-to-end test -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0" Visibility="{Binding HasCable, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding RecordTest}" VerticalAlignment="Center" Margin="12,0,0,0"
                            IsEnabled="{Binding CanTest}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Record 5-second test" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Hear what others hear" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding TestStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
