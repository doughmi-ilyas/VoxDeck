<UserControl x:Class="VoxDeck.App.Features.Player.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls">
    <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
        <StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Selected sound -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Current.Model.Title, FallbackValue='No sound selected'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Transport -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasCurrent}">
                    <Button Style="{StaticResource PlayButton}" Command="{Binding TogglePlay}" ToolTip="Play / pause" AutomationProperties.Name="Play or pause">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Setter Property="Margin" Value="2,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Command="{Binding Stop}" Margin="8,0,0,0"
                            ToolTip="Stop this sound" AutomationProperties.Name="Stop" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8EE;" IsChecked="{Binding Loop}" Margin="2,0,0,0"
                                  ToolTip="Loop" AutomationProperties.Name="Loop" />
                </StackPanel>

                <!-- Timeline -->
                <Grid Grid.Column="2" Margin="20,0" IsEnabled="{Binding HasCurrent}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:WaveformView Peaks="{Binding Peaks}" Progress="{Binding Progress, Mode=OneWay}" StartMarker="{Binding StartMarker, Mode=OneWay}"
                                           SeekCommand="{Binding Seek}" SetStartCommand="{Binding SetStart}"
                                           FocusVisualStyle="{StaticResource Focus}" AutomationProperties.Name="Timeline" />
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding StartText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Visibility="{Binding HasStart, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource SmallButton}" Content="Reset" Command="{Binding ResetStart}" Margin="8,0,0,0"
                                    Visibility="{Binding HasStart, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource SmallButton}" Content="Set start here" Command="{Binding SetStart}" Margin="8,0,0,0"
                                    ToolTip="Tiles will start this sound from the current position" />
                        </StackPanel>
                        <TextBlock Text="Click to jump · drag to scrub · right-click to set the start" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>

                <!-- Per-sound volume -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasCurrent}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0" />
                    <Slider Width="110" Maximum="1" Value="{Binding Volume}" ToolTip="Volume for this sound" AutomationProperties.Name="Sound volume" />
                    <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Width="42" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
