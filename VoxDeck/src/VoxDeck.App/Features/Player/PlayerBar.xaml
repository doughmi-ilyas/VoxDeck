<UserControl x:Class="VoxDeck.App.Features.Player.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Now playing (click to edit it) -->
            <Button Style="{StaticResource Plain}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Command="{Binding DataContext.OpenNowPlaying, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Now playing" ToolTip="Edit the playing sound">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="9" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Surface2}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnyPlaying}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:LogoMark Width="20" Height="20" IsActive="{Binding AnyPlaying}" />
                    </Border>
                    <StackPanel Width="270" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NowSubtitle}" Style="{StaticResource FaintText}" />
                        <ProgressBar Style="{StaticResource NowBar}" Value="{Binding NowProgress, Mode=OneWay}" Margin="0,6,0,0"
                                     Visibility="{Binding AnyPlaying, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Stop all -->
            <Button Grid.Column="1" Style="{StaticResource StopPill}" Command="{Binding StopAll}" Tag="{Binding AnyPlaying}"
                    AutomationProperties.Name="Stop all sounds" ToolTip="Stop every sound that is playing">
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="Stop all" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Output + master volume -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="14" Foreground="{DynamicResource Faint}" />
                <TextBlock Text="{Binding OutputName}" Style="{StaticResource FaintText}" MaxWidth="160" Margin="6,0,20,0" VerticalAlignment="Center" ToolTip="{Binding OutputName}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="15" Foreground="{DynamicResource Muted}" />
                <Slider Width="130" Margin="10,0,0,0" Value="{Binding MasterVolume}" AutomationProperties.Name="Master volume" ToolTip="Master volume" />
                <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:P0}}" Width="40" TextAlignment="Right" Margin="6,0,0,0"
                           Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
