<UserControl x:Class="VoxDeck.App.Features.AudioSetup.AudioSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoxDeck.App.Controls"
             controls:Motion.EnterOnLoad="True" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Audio" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20"
                       Text="VoxDeck uses your devices exactly as Windows set them up. It never changes Windows sound settings or microphone enhancements." />

            <!-- Microphone -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Command="{Binding Refresh}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Microphone" Style="{StaticResource H2}" />
                            <TextBlock Text="Pick the microphone VoxDeck should listen to" Style="{StaticResource FaintText}" />
                        </StackPanel>
                    </DockPanel>

                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMic}"
                             ItemContainerStyle="{StaticResource Option}" AutomationProperties.Name="Microphones" Margin="3,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <controls:SegMeter DockPanel.Dock="Right" Width="72" Height="6" Margin="12,0,0,0"
                                                       Level="{Binding DataContext.Level, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       On="{DynamicResource Accent}" Off="{DynamicResource Line}" Hot="{DynamicResource Warn}"
                                                       Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource Visible}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Windows default" Style="{StaticResource FaintText}" Visibility="{Binding IsDefault, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Faint}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MicStatus}" Style="{StaticResource FaintText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Output -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding TestOutput}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Play test sound" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Sound output" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding OutputName}" Style="{StaticResource FaintText}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="46,12,0,0">
                        <Run Text="Sounds play on your Windows default output." />
                        <Hyperlink Command="{Binding OpenSoundSettings}" Foreground="{DynamicResource Accent}">Open Windows sound settings</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Voice mixing: honest about what isn't there yet -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0" Background="{DynamicResource Surface2}">
                <DockPanel>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Hover}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Voice mixing" Style="{StaticResource H2}" />
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Hover}" Margin="10,0,0,0">
                                <TextBlock Text="Coming later" Foreground="{DynamicResource Muted}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                   Text="Sending your voice and your sounds into Discord or a game together needs a virtual audio cable. VoxDeck will guide you through it in a later version; nothing gets installed without asking." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
