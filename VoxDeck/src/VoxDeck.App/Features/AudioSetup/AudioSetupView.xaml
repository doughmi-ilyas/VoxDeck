<UserControl x:Class="VoxDeck.App.Features.AudioSetup.AudioSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Audio setup" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,20"
                       Text="VoxDeck uses your devices exactly as Windows set them up. It never changes Windows sound settings or microphone enhancements." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Refresh}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="Microphone" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMic}"
                             ItemContainerStyle="{StaticResource DeviceItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Microphones">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="  ·  Windows default" Foreground="{StaticResource TextMuted}"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Input level" Style="{StaticResource Muted}" Margin="0,16,0,8" />
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding Level, Mode=OneWay}" AutomationProperties.Name="Microphone input level" />
                    <TextBlock Text="{Binding MicStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="Sound effects output" Style="{StaticResource H2}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DefaultOutput}" Margin="0,10,0,4" />
                    <TextBlock Text="Sounds play on your Windows default output device." Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
