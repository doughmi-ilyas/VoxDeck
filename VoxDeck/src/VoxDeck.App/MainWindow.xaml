<Window x:Class="VoxDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:library="clr-namespace:VoxDeck.App.Features.Library"
        xmlns:setup="clr-namespace:VoxDeck.App.Features.AudioSetup"
        xmlns:player="clr-namespace:VoxDeck.App.Features.Player"
        Title="VoxDeck" Width="1180" Height="740" MinWidth="900" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type library:LibraryViewModel}">
            <library:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type setup:AudioSetupViewModel}">
            <setup:AudioSetupView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar: navigation on top, global controls at the bottom -->
        <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,24">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VoxDeck" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <DockPanel Margin="10,0,4,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" Style="{StaticResource Caption}" />
                        <TextBlock Text="Master volume" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <Slider Maximum="1" Value="{Binding MasterVolume}" Margin="10,0,4,16" AutomationProperties.Name="Master volume" />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StopAll}" HorizontalContentAlignment="Center"
                            ToolTip="Stop every sound that is playing" AutomationProperties.Name="Stop all">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Stop all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}" ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Width="28" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Page}" Focusable="False" />

        <player:PlayerBar Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding Player}" />
    </Grid>
</Window>
