<Window x:Class="VoxDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VoxDeck.App.Controls"
        xmlns:library="clr-namespace:VoxDeck.App.Features.Library"
        xmlns:setup="clr-namespace:VoxDeck.App.Features.AudioSetup"
        xmlns:settings="clr-namespace:VoxDeck.App.Features.Settings"
        xmlns:player="clr-namespace:VoxDeck.App.Features.Player"
        xmlns:editor="clr-namespace:VoxDeck.App.Features.Editor"
        xmlns:palette="clr-namespace:VoxDeck.App.Features.Palette"
        xmlns:mixer="clr-namespace:VoxDeck.App.Features.Mixer"
        xmlns:onboarding="clr-namespace:VoxDeck.App.Features.Onboarding"
        Title="VoxDeck" Width="1280" Height="800" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        AllowDrop="True" PreviewDragEnter="OnDragEnter" PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnSizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenPalette}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding Import}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Features/Modals/Modals.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate DataType="{x:Type library:LibraryViewModel}">
            <library:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type setup:AudioSetupViewModel}">
            <setup:AudioSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type mixer:MixerViewModel}">
            <mixer:MixerView />
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <controls:LogoMark x:Name="TitleMark" Width="16" Height="16" />
                    <TextBlock Text="VoxDeck" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource TitleSearch}" Command="{Binding OpenPalette}"
                        Visibility="{Binding Onboarding.IsOpen, Converter={StaticResource Visible}, ConverterParameter=not}"
                        AutomationProperties.Name="Search sounds and actions">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}">
                            <TextBlock Text="Ctrl K" />
                        </Border>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" />
                        <TextBlock Text="Search sounds and actions" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 232 wide, or icons only in a narrow window (see OnSizeChanged) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,12">
                    <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding IsWide, Converter={StaticResource Visible}}">
                        <TextBlock Text="DEVICES" Style="{StaticResource SectionLabel}" />
                        <Button Style="{StaticResource Plain}" Command="{Binding GoToAudio}" AutomationProperties.Name="Audio devices" ToolTip="Open audio setup">
                            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                            <TextBlock Text="{Binding Router.MicState}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,9,0" />
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Router.MicName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Microphone" Style="{StaticResource FaintText}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                            <TextBlock Text="OK" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,9,0" />
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Router.MonitorName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Sound output" Style="{StaticResource FaintText}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Router.IsRunning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource OkSoft}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Router.VoiceBadge}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,9,0" />
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Voice chat" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Mic + sounds to Discord" Style="{StaticResource FaintText}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource Quick}" Command="{Binding Import}" Margin="0,10,0,0" AutomationProperties.Name="Add sounds">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}">
                                    <TextBlock Text="Ctrl O" />
                                </Border>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Add sounds" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}"
                             ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navigation">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Title}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource Faint}" FontWeight="Medium" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.IsWide, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16" Width="28" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.IsWide, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Page + editor drawer -->
            <Grid x:Name="PageHost" Grid.Column="1" ClipToBounds="True">
                <ContentControl Content="{Binding Page}" Focusable="False" />
                <Border x:Name="Drawer" Width="340" HorizontalAlignment="Right" Visibility="Collapsed"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DrawerShift" X="380" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.16" />
                    </Border.Effect>
                    <editor:SoundEditorView x:Name="EditorView" DataContext="{Binding Editor}" />
                </Border>
            </Grid>
        </Grid>

        <player:PlayerBar x:Name="Bar" Grid.Row="2" DataContext="{Binding Player}" />

        <!-- First-run setup, over everything but the title bar -->
        <onboarding:OnboardingView Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding Onboarding}"
                                   Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />

        <!-- Dialogs: one at a time over everything; Esc or a click outside closes it -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Modals.Current, Converter={StaticResource Visible}}">
            <Border Background="{DynamicResource Backdrop}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding Modals.Close}" />
                </Border.InputBindings>
            </Border>
            <ContentControl Content="{Binding Modals.Current}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            Focusable="False" KeyboardNavigation.TabNavigation="Cycle" />
        </Grid>

        <!-- Toasts -->
        <ItemsControl Grid.RowSpan="3" ItemsSource="{Binding Toasts.Items}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                      Margin="16,0,16,90" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12"
                            Padding="14,10,10,10" Margin="0,8,0,0" MinWidth="300" MaxWidth="560" controls:Motion.EnterOnLoad="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22" />
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Height="28" Padding="10,0" Margin="12,0,0,0"
                                    Content="{Binding ActionText}" Foreground="{DynamicResource Accent}"
                                    Command="{Binding DataContext.Toasts.RunAction, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding ActionText, Converter={StaticResource Visible}}" />
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="error">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="ok">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Ok}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Drop zone while files are dragged over the window -->
        <Border Grid.RowSpan="3" Background="{DynamicResource Backdrop}" AllowDrop="True" Drop="OnDrop" DragLeave="OnDragLeave"
                Visibility="{Binding IsDraggingFiles, Converter={StaticResource Visible}}">
            <Grid Margin="40" IsHitTestVisible="False">
                <Rectangle RadiusX="20" RadiusY="20" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="6 4" Fill="{DynamicResource Surface}" Opacity="0.94" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop to add sounds" Style="{StaticResource H2}" FontSize="18" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="WAV, MP3, M4A, AAC, WMA and FLAC. Your files stay where they are." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <palette:PaletteView Grid.RowSpan="3" DataContext="{Binding Palette}" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />
    </Grid>
</Window>
